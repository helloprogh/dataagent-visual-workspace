# Standard AG-UI endpoint. No CopilotRuntime and no OpenCode session creation.
# Direct cross-origin example:
# VITE_AGUI_URL=http://localhost:3001/agent
#
# Vite dev proxy example (recommended for local development):
VITE_AGUI_URL=/api/agui
VITE_AGUI_PROXY_TARGET=http://localhost:3001

# File upload endpoint used by CopilotKit attachments.
# In production this can stay on the same origin. During local development,
# point VITE_AGUI_UPLOAD_PROXY_TARGET at the service that implements POST /api/agui/upload.
VITE_AGUI_UPLOAD_URL=/api/agui/upload
VITE_AGUI_UPLOAD_PROXY_TARGET=http://localhost:3001

VITE_AGENT_ID=data-agent
VITE_AGENT_DISPLAY_NAME=Data Agent

# Optional Bearer token. VITE_* values are visible to the browser.
VITE_AGUI_TOKEN=

# false (default): empty production workspace; true: seed full demo data.
VITE_DEMO_MODE=false
