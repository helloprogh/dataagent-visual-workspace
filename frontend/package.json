{
  "name": "dataagent-vue-agui",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "dev:scenario": "vite --mode scenario",
    "dev:gallery": "vite --mode gallery",
    "check:contrast": "node scripts/contrast-check.mjs",
    "build": "npm run check:contrast && vue-tsc -b && vite build",
    "build:demo": "npm run check:contrast && vue-tsc -b && vite build --mode demo",
    "build:scenario": "npm run check:contrast && vue-tsc -b && vite build --mode scenario",
    "build:gallery": "npm run check:contrast && vue-tsc -b && vite build --mode gallery",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "check:offline": "node scripts/offline-check.mjs",
    "diagnose:npm": "node scripts/npm-diagnose.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@milkdown/crepe": "7.22.1",
    "@milkdown/kit": "7.22.1",
    "@milkdown/vue": "7.22.1",
    "echarts": "6.1.0",
    "element-plus": "2.14.3",
    "vue": "3.5.28",
    "vue-element-plus-x": "2.0.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.1",
    "typescript": "5.8.2",
    "vite": "6.4.3",
    "vue-tsc": "2.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@10.9.2"
}
