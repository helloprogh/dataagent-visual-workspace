ADAPTER_PORT=3001
OPENCODE_BASE_URL=http://127.0.0.1:4096
# Optional. Defaults to the directory where the adapter process starts.
OPENCODE_WORKSPACE_DIRECTORY=D:\ProjectSpace\dataagent
AGUI_LANGUAGE_COOKIE=locale

# Browser request paths are hardcoded under /dataagent/web/api/. Only proxy targets remain configurable.
VITE_AGUI_PROXY_TARGET=http://127.0.0.1:3001
VITE_AGUI_UPLOAD_PROXY_TARGET=http://127.0.0.1:3001
VITE_DEMO_MODE=false
